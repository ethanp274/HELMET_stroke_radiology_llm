# --- Patient data: never commit ---
# Radiology reports and every derived text dataset are patient data.
# Nothing under data/ is ever committed.
data/*
*.csv
*.xlsx
*.dta
*.parquet
*.jsonl
data/
models/
*.safetensors
*.bin
*.pt

