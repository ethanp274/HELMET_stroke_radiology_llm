results/figures/
results/raw_model_output/
*.png
*.pdf
*.svg

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Environments ---
.venv/
.*venv/
venv/
env/
.env

